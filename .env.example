# Copy to .env and fill in, then `chmod 600 .env`. .env is gitignored — never commit real values.
# MCP servers read this file at startup (.mcp.json -> --env-file .env):
# restart Claude Code after every edit, the values are not re-read per call.

# Atlassian (mcp-atlassian). Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://<workspace>.atlassian.net
JIRA_USERNAME=<atlassian-account-email>
JIRA_API_TOKEN=<api-token>

# Confluence (optional, same server + same token). URL MUST end with /wiki.
# Commented out = optional: the SessionStart preflight (check-project-deps.sh) checks
# only active KEY= lines. Uncomment to enable the /confluence skill.
# CONFLUENCE_URL=https://<workspace>.atlassian.net/wiki
# CONFLUENCE_USERNAME=<atlassian-account-email>
# CONFLUENCE_API_TOKEN=<api-token>

# PR review comments (/pr-comments). All optional — uncomment the block for your git host.
# GitHub: fine-grained PAT, permission "Pull requests: Read and write" on the repo.
# https://github.com/settings/personal-access-tokens/new  (GHE: also GITHUB_API_URL=https://<host>/api/v3)
# GITHUB_TOKEN=<fine-grained-pat>

# Bitbucket Cloud: personal Atlassian API token with scopes, app Bitbucket,
# read:pullrequest:bitbucket + read:user:bitbucket. Basic auth needs the ACCOUNT email as username.
# BITBUCKET_EMAIL=<atlassian-account-email>   # leave unset to use a repository access token (Bearer) — then --mine/whoami are unavailable
# BITBUCKET_TOKEN=<api-token-with-scopes>

# GitLab: personal access token, scope "api" (read_api cannot post notes).
# https://gitlab.com/-/user_settings/personal_access_tokens
# GITLAB_TOKEN=<personal-access-token>
