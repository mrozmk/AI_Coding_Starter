# ============================================================
# OS / Editor
# ============================================================
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# ============================================================
# Secrets & local config — NEVER commit
# ============================================================
.env
.env.*
.mcp.json
*.pem
*.key
*secret*
*credentials*

# ============================================================
# Claude Code — local-only state
# ============================================================
.claude/audit.log
.claude/settings.local.json
# /orchestrate umbrella mode creates per-step worktrees (full repo checkouts) here
.claude/worktrees/
# Local read-usage telemetry written by track-memory-read.sh (per-clone, not shared)
.claude/memory-usage.json
# Harness runtime state (created by Claude Code at run time, never shared)
.claude/scheduled_tasks.lock
# Atomic-write temp from the same hook (jq > $DB.tmp && mv) — a crash can leave it behind
.claude/*.tmp
# Guard against accidental copy of ~/.claude/projects/ (transcripts + auto-memory) into repo
**/.claude/projects/

# ============================================================
# Per-developer memory — committed as .example, filled in locally
# ============================================================
# Each developer copies user-profile.md.example -> user-profile.md and describes how THEY
# work. Committing it would push one person's preferences into everyone else's checkout.
# One-time untrack when adopting this rule in a repo that already tracked the file:
#   git rm --cached .agents/memory/user-profile.md
# (the working copy survives and becomes that developer's local profile)
.agents/memory/user-profile.md

# Local AI deployment-context note (starter context for fresh AI windows, not shipped content)
AI_DEPLOYMENT_CONTEXT.md


