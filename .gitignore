# ============================================================
# QA / browser-automation evidence — point-in-time, never repo history
# ============================================================
# Screenshots, traces and network dumps written by Playwright MCP during /test-e2e
# and QA runs. Keep the path in sync with .claude/qa-env.json -> artifacts_dir;
# .claude/lib/qa-probe.sh warns when the two disagree.
.playwright-mcp/

# ============================================================
# Logs & temp
# ============================================================
*.log
tmp/
temp/
.cache/

# ============================================================
# Coverage / test artifacts
# ============================================================
coverage/
.coverage
.nyc_output/
htmlcov/

# ============================================================
# Session handoffs — generated by /handoff, local scratchpad, not versioned
# ============================================================
# NOT ignored here on purpose: a repo-level ignore makes handoffs invisible to
# the CLI `@` file-reference and greys them out in editors. To keep them
# referenceable yet unversioned, exclude them LOCALLY (per clone) instead:
#   echo '.agents/handoffs/*'      >> .git/info/exclude
#   echo '!.agents/handoffs/.gitkeep' >> .git/info/exclude
# .git/info/exclude is not committed, so each clone sets this once.
