{
  "$comment": "Assessment records (Phase A): the single durable artifact the refutation submission and report 2's finding cards are rendered from. Validated by `node .claude/lib/arch-assess.mjs check records` and again by `score`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "areas", "class", "tier", "breach", "status", "sources", "verified_by", "evidence_kind", "candidate", "claim", "rule", "anchors", "consequence", "consequence_kind", "change", "effort", "confidence", "correction_note"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "areas": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "class": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 12 }, { "const": "candidate" }] },
          "tier": { "enum": ["now", "next", "later", "none"] },
          "breach": { "type": "boolean" },
          "status": { "enum": ["finding", "correction", "dropped"] },
          "sources": { "type": "array", "minItems": 1, "items": { "enum": ["claude", "codex"] } },
          "verified_by": { "enum": ["main-session", "sweep-only", "codex"] },
          "evidence_kind": { "enum": ["static", "test", "probe", "runtime"] },
          "candidate": { "type": ["integer", "null"] },
          "claim": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "line": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "consequence": { "type": "string", "minLength": 1 },
          "consequence_kind": { "enum": ["measured", "predicted"] },
          "change": { "type": "string", "minLength": 1 },
          "effort": { "enum": ["S", "M", "L"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "correction_note": { "type": ["string", "null"] }
        }
      }
    }
  }
}
