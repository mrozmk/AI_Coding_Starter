{
  "_comment": "Role profile for the TeamLead: an extra --settings layer. It narrows writes (deny/ask) and allows only named reads plus the agent-mail client; arrays merge across layers and deny/ask beat allow. The PR host's update verbs are denied at materialise time from teams.pr_provider (github: gh pr merge/edit, azure-devops: az repos pr update), so this file carries none. The launcher materialises it ({{CLONES}} expanded from teams.clone_parent/clone_name, the project and local deny/ask rules unioned, the operator kit's Notification and Stop hooks added); _samples feed session_profile_check.py. Project-specific named reads go into the project's own copy, each with a matching _samples.reads line. Contract: .agents/reference/supervisor-sessions.md#teamlead",
  "env": {
    "TEAM_SESSION_ROLE": "TeamLead"
  },
  "permissions": {
    "allow": [
      "Read({{CLONES}}/**)",
      "Bash(bash .claude/lib/team-mail.sh * inbox *)",
      "Bash(bash .claude/lib/team-mail.sh * recipients)",
      "Bash(bash .claude/lib/team-mail.sh * recipients *)",
      "Bash(bash .claude/lib/team-mail.sh * ack *)",
      "Bash(bash .claude/lib/team-mail.sh * send *)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(bash .claude/lib/team-new.sh*)",
      "Bash(bash .claude/lib/team-next.sh*)",
      "Bash(bash .claude/lib/team-remode.sh*)",
      "Bash(bash .claude/lib/team-integrate.sh*)",
      "Bash(bash .claude/lib/supervisor-sessions.sh freeze*)",
      "Bash(bash .claude/lib/supervisor-sessions.sh rollback*)",
      "Bash(bash .claude/lib/supervisor-sessions.sh answer*)",
      "Bash(bash .claude/lib/supervisor-sessions.sh here*)",
      "Bash(bash .claude/lib/team-watch.sh routing*)",
      "Bash(bash .claude/lib/team-watch.sh mode answering*)",
      "Skill(pr-merge)",
      "Skill(pr-merge *)",
      "Skill(release)",
      "Skill(release *)"
    ],
    "ask": [
      "Bash(cat .env*)",
      "Read(**/.env*)"
    ]
  },
  "_samples": {
    "forbidden": [
      "git push origin feat/x",
      "bash .claude/lib/team-new.sh alfa 12 feat/12-x origin/main",
      "bash .claude/lib/team-next.sh alfa 13",
      "bash .claude/lib/team-remode.sh alfa brainstorm",
      "bash .claude/lib/team-integrate.sh alfa",
      "bash .claude/lib/supervisor-sessions.sh freeze on 1.4.0",
      "bash .claude/lib/supervisor-sessions.sh rollback",
      "bash .claude/lib/supervisor-sessions.sh answer Advisor --fp x yes",
      "bash .claude/lib/supervisor-sessions.sh here Supervisor",
      "bash .claude/lib/team-watch.sh routing split",
      "bash .claude/lib/team-watch.sh mode answering on"
    ],
    "skills": [
      "Skill(pr-merge)",
      "Skill(pr-merge *)",
      "Skill(release)",
      "Skill(release *)"
    ],
    "allowed": [
      "bash .claude/lib/team-question.sh alfa answer q-1 --tier 1",
      "bash .claude/lib/team-escalate.sh alfa coder 2 x",
      "bash .claude/lib/team-watch.sh ack 12",
      "bash .claude/lib/team-watch.sh mode tiers on"
    ],
    "reads": [
      "bash .claude/lib/team-mail.sh --here inbox --for TeamLead --unread",
      "bash .claude/lib/team-mail.sh --here recipients",
      "bash .claude/lib/team-mail.sh --here send --to Supervisor --kind turn --body x"
    ],
    "secrets": [
      "cat .env",
      "cat .env.local",
      "Read(.env)",
      "Read(services/api/.env.local)"
    ],
    "writes": [
      "git push --force origin main",
      "bash .claude/lib/team-new.sh alfa 12 feat/12-x origin/main",
      "rm -rf /",
      "bash .claude/team/sessions/operator-kit/install.sh --apply"
    ]
  }
}
