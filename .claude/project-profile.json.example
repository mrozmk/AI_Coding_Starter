{
  "_doc": "Project profile — written by /setup:start after the bootstrap interview, committed. Machine-readable mirror of the answers; `CLAUDE.md → ### Branch model` and `Language Rules` are the human-readable mirror and are filled from the same values. Consumers: /setup:create-CLAUDE_MD (workflow, language), /pr-create (git_host), /maintain:sync-from-starter (excluded paths + which .mcp.json / settings.json entries to skip). Copy to project-profile.json only via /setup:start — never by hand.",

  "schema": 1,

  "_mode_doc": "greenfield | brownfield. Detected from the project file count (>= 50 files => brownfield), confirmed in the interview.",
  "mode": "greenfield",

  "_git_host_doc": "github | bitbucket | gitlab | none. Detected from `origin`, confirmed. `none` = no remote yet; PR credentials are deferred until one exists.",
  "git_host": "github",

  "_workflow_doc": "Asked: preset + pr_required (Screen 1, Q3). Everything else is DERIVED once from the preset table in create-CLAUDE_MD → Identify Git Workflow and never asked. preset is one of trunk | feature-branch | gitflow — `custom` is not a profile value; a custom workflow goes through /setup:create-CLAUDE_MD instead. pr_required=false (\"I push straight to main\") overrides pr_dest / protected / merge / orchestrate_publish as shown here.",
  "workflow": {
    "_preset_doc": "trunk | feature-branch | gitflow",
    "preset": "trunk",
    "pr_required": false,
    "trunk": "main",
    "integration": "main",
    "branch_types": ["feat", "fix", "chore", "refactor"],
    "_branch_pattern_doc": "Derived from the tracker answer: jira => <type>/<KEY>-<slug>, none => <type>/<slug>.",
    "branch_pattern": "<type>/<slug>",
    "pr_dest": "commit on main or short-lived branches merged locally — no PR",
    "protected": [],
    "_merge_doc": "squash | merge-commit | ff. `ff` only for the direct-push override; otherwise the preset's implied value.",
    "merge": "ff",
    "_orchestrate_publish_doc": "push | branch-local. gitflow and any PR-gated flow => branch-local; direct push and feature-branch => push.",
    "orchestrate_publish": "push",
    "_jira_transition_doc": "Opt-in Jira transition guard (.claude/hooks/guard-jira-transition.sh). jira_transition_comment: true → a jira_transition_issue call without a comment is refused. jira_transition_evidence: {\"<PROJECT>:<transition id>\": \"<case-insensitive ERE>\"} — that transition's comment must match, e.g. {\"PROJ:31\": \"Release-[0-9]+|no deploy\"}; ids are workflow-scoped, hence the project prefix. \"*:<transition id>\" applies to every project without its own string key (the exact key wins; an exact \"\" opts a project out). Default: off, no rules.",
    "jira_transition_comment": false,
    "jira_transition_evidence": {},
    "_tracker_comments_doc": "Opt-in: true → ticket comments are requirements (.agents/reference/tracker-comments.md) — /brainstorm and /quick-change snapshot them, /execute, /check-implementation and /pr-merge check for new ones. Default: off, no extra tracker reads.",
    "tracker_comments": false,
    "_pr_open_doc": "Opt-in: true → /pr-create opens the PR (github: gh, azure-devops: az) after showing the full draft and an explicit Create answer, with your local CLI identity. Default: off — the command only prepares the PR for you to open.",
    "pr_open": false,
    "_guarded_writes_doc": "Opt-in: true → .claude/lib/guarded-writes/{az-write,ops-write,sqlcmd-write}.sh run allow-listed writes under the write profile ~/.azure-write, from .claude/guarded-writes.json once that file is on origin/<Trunk>. The Operator also sets read-only default identities and pastes the settings block (.agents/reference/guarded-writes.md). Default: off — the wrappers refuse.",
    "guarded_writes": false,
    "_local_env_doc": "Opt-in: true → .claude/lib/local-env/with-local-env.sh runs a runner registered in .claude/local-env.json (once that file is on origin/<Trunk>) with one local dev secret from ~/.config/<dir>/local.env, given only to that child's env and masked in its output. The Operator writes the file with local-env-init.sh and pastes the settings block (.agents/reference/local-env-runner.md). Default: off — the runner refuses.",
    "local_env": false,
    "_remote_build_doc": "Opt-in: true → teams.build_check can be \"bash \\\"$HARNESS_MAIN/.claude/lib/remote-build/remote-build-check.sh\\\"\": the build/test command runs on a remote node over ssh (never locally), from .claude/remote-build.json once that file is on origin/<Trunk> — the node is chosen only through trunk. The node must be a machine for untrusted code (.agents/reference/remote-build.md). Default: off — the check refuses.",
    "remote_build": false
  },

  "_tracker_doc": "jira | github | none. Asked (Screen 2, Q4). none => the backlog is .agents/backlog.md. github => the tasks are the issues of github.repo; .claude/lib/team-tracker.sh reads them without a teams block.",
  "tracker": "none",

  "_github_doc": "Only for tracker=github (and read by the team layer when teams.github is absent: one block for both paths; teams.github wins when both exist). repo: owner/repo, required. The Project fields — project_owner, project_number, project_id, status_field_id, status_options.started/.delivered — are all present or all omitted: omitted = No Project, and status moves are skipped. IDs once with `gh project field-list <number> --owner <owner> --format json`. Teams always need the Project. Neutral example values.",
  "github": {
    "repo": "owner/repo",
    "project_owner": "owner",
    "project_number": 1,
    "project_id": "PVT_example",
    "status_field_id": "PVTSSF_example",
    "status_options": {"started": "opt-started-example", "delivered": "opt-delivered-example"}
  },

  "_status_report_doc": "OPTIONAL, NOT asked by /setup:start; add by hand. Read by /tasks-status only. jira_jql: the JQL that picks the tasks the report covers when the tracker is jira; omitted => `assignee = currentUser() AND statusCategory != Done ORDER BY status, key` (my open issues, across projects) and the report says it used that default.",
  "status_report": {
    "jira_jql": "project = PROJ AND statusCategory != Done ORDER BY status, key"
  },

  "_confluence_doc": "Asked (Screen 2, Q5). Shares the Atlassian MCP server and token with Jira.",
  "confluence": false,

  "_codex_doc": "Asked (Screen 2, Q6) as a TEAM question. `command -v codex` on the bootstrap machine is informational only and never sets this field — the file is shared.",
  "codex": false,

  "_app_surface_doc": "unknown | none | web | mobile | desktop | tui. NOT asked by /setup:start — always written as `unknown`, which keeps all QA tooling. /setup:create-CLAUDE_MD detects it from the stack once code exists.",
  "app_surface": "unknown",

  "_language_doc": "pl | en. Asked first (Screen 0). Governs Claude <-> developer communication only; code, comments and commits stay English.",
  "language": "pl",

  "_teams_doc": "Values the team harness (/start-team, /monitor, .claude/lib/team-*.sh) reads instead of hardcoding them. Written by /setup:teams; a project without this block refuses /start-team before any side effect. Read with `jq` only — never eval'd or sourced. tracker: jira | github | none (sets the ticket-key regex; none = local `L<n>` keys allocated by team-tracker.sh, zero tracker calls). github: REQUIRED when tracker=github or pr_provider=github, ignored otherwise; absent => the top-level github block is used (the whole block, never a per-field merge) — repo (`owner/repo`), project_owner, project_number plus the Project v2 IDs project_id, status_field_id and status_options.started/.delivered (read the IDs once with `gh project field-list <number> --owner <owner> --format json`). pr_provider: azure-devops | github | none (none = the PR layer is off: setup, the channel, the operator kit and the supervision roles work, team runs, PRs and merges refuse naming the setting); github.repo is required for pr_provider=github too. trunk: the line team branches are cut from (base-ref = origin/<trunk>). branch_types: allowed <type>/<key>-<slug> prefixes. required_tools: must be on PATH before a team starts; the session host (tmux or Herdr) is checked separately. clone_parent: OPTIONAL — where team clones live; omit it for the default (siblings of this repo). A leading ~ is expanded and spaces are allowed. clone_name: OPTIONAL — the clone directory template; omit it for the default `<repo dir>-{team}`. `{team}` is the team name, `{Team}` its capitalized form, and the placeholder must END the template (exactly one, no `/`) because the clone glob is a prefix. seed_files: copied into every clone (.env is chmod 600 when listed). env_file_required: refuse to start without a mode-600 .env. build_check: the build command, run with `bash -c` in the clone root. test_gate: a script path, or `none` to skip the gate. gates: auto | manual-mql5 (manual-mql5 = the gates are run by hand and the QA report says so). Values below are neutral examples — not any project's real ones.",
  "teams": {
    "tracker": "github",
    "github": {
      "repo": "owner/repo",
      "project_owner": "owner",
      "project_number": 1,
      "project_id": "PVT_example",
      "status_field_id": "PVTSSF_example",
      "status_options": {"started": "opt-started", "delivered": "opt-delivered"}
    },
    "pr_provider": "github",
    "trunk": "main",
    "branch_types": ["feature", "bugfix", "chore"],
    "clone_name": "<repo>-{team}",
    "required_tools": ["git", "jq", "claude", "codex", "gh"],
    "seed_files": [".claude/settings.local.json", ".agents/memory/user-profile.md"],
    "env_file_required": false,
    "build_check": "echo 'no build check configured'",
    "test_gate": "none",
    "gates": "auto",
    "_session_prefix_doc": "OPTIONAL — the prefix of every session name the session host starts: <prefix>-<team>-<role>, <prefix>-<role>, <prefix>-<helper>, so two checkouts on one machine never collide. Lowercase, [a-z0-9][a-z0-9_-], at most 12 characters; another value stops the start with the key named. Empty = not set: channel.tmux_prefix, else the repo dir slug, lowercased and cut to 12 with a warning. A team name whose longest session name exceeds 32 characters is refused by team-new.sh.",
    "session_prefix": "",
    "_session_host_doc": "OPTIONAL — where sessions run: auto | tmux | herdr (default auto). herdr: herdr-core through `hc` (its core must answer `hc server status`, else a start stops with exit 6). auto: tmux for now — Herdr is picked only when chosen explicitly, until the Herdr backend has been checked on a live Herdr. A running session stays on the backend it was started on. TEAM_SESSION_HOST overrides this key. A session host (tmux, or Herdr when chosen) is checked at team start, so tmux need not be in required_tools.",
    "session_host": "auto",
    "_channel_doc": "OPTIONAL — names and policy of the agent-mail channel between the supervision roles (Supervisor, TeamLead, Advisor, Reviewer), shared by the whole team; machine paths never go here (they live in the gitignored .agents/team/channel.local.json written by /setup:teams → channel). project_code: the registry key and message label for this project. mail_suffix: appended to every role name to form the recipient name (Advisor + XY = AdvisorXY), so two projects on one machine never share a recipient; may be empty. tmux_prefix: prefix of the role sessions' tmux names (default: the repo dir slug). advisor: pair (a Reviewer on a second-vendor model co-signs tier-2 decisions) | solo (the Advisor decides alone, every note says reviewer: none). Notifications are not configured here: ~/.agent-comms/notify.json (.claude/lib/notify.sh). Defaults when a key is absent: mail_suffix empty, tmux_prefix the repo dir slug, advisor pair when codex is true else solo. Read by .claude/lib/team-channel.sh (team_channel_load), never parsed elsewhere. Schema and protocol: .agents/reference/agent-mail.md.",
    "_policy_doc": "OPTIONAL — project policy of the supervision model; every key optional, an absent key = the conservative behaviour named here, never another project's values. The values below are one project's choices, shown as examples to adopt consciously. sensitive_paths: globs whose changes make a team question tier 2 (Advisor pair) and a QA ready-with-warnings the Advisor's disposition; absent = the list in CLAUDE.md → Validation → Test policy. A judgement input for the TeamLead and the Advisor (attested, not proven) — no script enforces it yet. classes: the deterministic tier-1 waivers of an ask-tier prompt (merge_line, allow_offline, add_ask, prod_diagnose — prod_diagnose also needs dir, a relative directory of read-only diagnose scripts, and privileged, a regex of the subcommands that are not); deny, egress, the SQL guard and unreadable prompts are never waived. Each class is OFF until its enabled is exactly true here; the Operator's runtime switch (team-watch.sh mode class <name> off) can then narrow it, never widen it. prod_diagnose also needs dir and privileged. pr: self_approve (default false) lets /pr-merge vote approve on the user's own PR and arm auto-complete; off = it stops and names the missing approval or the running policy. tickets: labels and lines on tickets the Supervisor/Advisor create from recommendations; absent = no labels, the recommendation line is still written. closure: automatic ticket-closure rules the Supervisor applies; absent = no automatic closure. Human overview: docs/teams/06-permissions.md (starter repo).",
    "policy": {
      "sensitive_paths": ["src/payments/**", "src/auth/**", "src/webhooks/**", "src/licensing/**"],
      "classes": {
        "merge_line": {"enabled": false},
        "allow_offline": {"enabled": false},
        "add_ask": {"enabled": false}
      },
      "pr": {"self_approve": false},
      "tickets": {
        "auto_label": "auto-created",
        "path_labels": {"brainstorm": "brainstorm", "quick": "quick-change", "team": "team", "analysis": "analysis"},
        "recommendation_line": "Created from a recommendation — the Operator verifies it when the work starts",
        "new_epic_when_none_fits": true
      },
      "closure": {
        "done_after_release_minutes_without_5xx": 40,
        "dry_run_max_days": 7,
        "on_hold_after_days": 7
      }
    },
    "channel": {
      "project_code": "XY",
      "mail_suffix": "XY",
      "tmux_prefix": "xy",
      "advisor": "pair"
    },
    "_teamlead_doc": "OPTIONAL — the per-run TeamLead: one lead session per team run that gates the spec/plan, answers the team's questions, accepts the result against the order brief and escalates only human-only decisions to the Operator. enabled: true switches a project from the global TeamLead to the per-run one (default false — nothing changes). human_only: rule groups whose prompts only the Operator answers — settings-profiles (settings and permission-profile changes) and prod-ask (the project's production ask rules); default both. rework_budget.brainstorm / .quick: rework rounds after a rejected acceptance before the Operator decides (defaults 2 and 1). revise_limit: revise verdicts per gate before the lead must escalate (default 3, at least 1). The values below equal the defaults. Contract: .agents/reference/team-lead.md.",
    "teamlead": {
      "enabled": false,
      "human_only": ["settings-profiles", "prod-ask"],
      "rework_budget": {"brainstorm": 2, "quick": 1},
      "revise_limit": 3
    },
    "_sessions_doc": "OPTIONAL — the project's role sessions, read by .claude/lib/roles-lib.sh (the one reader) for /roles (roles.sh), the SessionStart contract line and the per-run TeamLead. One key per role, name ^[A-Z][A-Za-z0-9]{1,23}$; a project adds or replaces a role by editing this block, never the code. Fields: cli claude (default) | codex; model (a model name or alias); effort low | medium | high | xhigh | max; settings (Claude only: a .claude/team/sessions/<name>.settings.json template, materialised per role with env TEAM_SESSION_ROLE = the role); contract (a repo-relative file: the hook names it to a Claude role, a Codex role gets it on its launch line); place {tab, slot main | side} (at most one main per tab; Herdr placement); standing (default true; false = per-run configuration nobody starts from /roles — the TeamLead, whose model and effort the runner reads, default fable · high); enabled (default true). Every rule is checked before /roles starts anything. Absent block = the four roles below. The old shape ({model, effort} only) still reads, with these values as defaults for the missing fields; a legacy Advisor key is read as Fable with a warning. A running window picks up a change only after /roles stop <Role> and /roles.",
    "sessions": {
      "Supervisor": {"cli": "claude", "model": "opus", "effort": "medium", "settings": "Supervisor",
                     "contract": ".agents/reference/roles/supervisor.md", "place": {"tab": "Lead", "slot": "main"}},
      "Fable": {"cli": "claude", "model": "fable", "effort": "high", "settings": "Advisor",
                "contract": ".agents/reference/roles/advisor.md", "place": {"tab": "Lead", "slot": "side"}},
      "Astra": {"cli": "codex", "model": "astra", "effort": "high",
                "contract": ".agents/reference/roles/advisor.md", "place": {"tab": "Lead", "slot": "side"}},
      "TeamLead": {"standing": false, "cli": "claude", "model": "fable", "effort": "high"}
    }
  },

  "_jira_doc": "Jira sync settings. estimates: none | timetracking | <custom field id> — none = no time estimate is sent (sizes stay in the description); absent = the field remembered in .agents/memory/domain/jira.md, else $JIRA_ESTIMATE_FIELD, else timetracking. commit_drafts: reserved — committing .agents/jira/ is unsupported in v1.",
  "jira": { "estimates": "timetracking", "commit_drafts": false },

  "_ba_doc": "BA profile. enabled: a Business Analyst runs discovery and the backlog in this repo (written by /setup:start later; nothing reads it yet). meetings_dir: where raw transcripts are dropped for /meeting-notes. vendor / client: participant-group labels in meeting notes (defaults Vendor / Client). Absent block = BA profile off.",
  "ba": { "enabled": false, "meetings_dir": ".agents/sources/meetings/", "vendor": "", "client": "" },

  "_commands_doc": "The command-group manifest, DERIVED from the answers above and shown for confirmation. false => /setup:start offers to prune the group (files + coupled edits) and records the deleted paths in .claude/.starter-sync.json → excluded. qa_runtime_ui is true whenever app_surface is unknown or web. ba = the BA command group (meeting-notes, update-backlog, check-backlog, resync) — pruning arrives with the /setup:start interview.",
  "commands": {
    "pr": true,
    "jira": false,
    "confluence": false,
    "codex": false,
    "qa_runtime_ui": true,
    "ba": false
  }
}
