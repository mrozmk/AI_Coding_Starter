{
  "_doc": "Project profile — written by /setup:start after the bootstrap interview, committed. Machine-readable mirror of the answers; `CLAUDE.md → ### Branch model` and `Language Rules` are the human-readable mirror and are filled from the same values. Consumers: /setup:create-CLAUDE_MD (workflow, language), /pr-create (git_host), /maintain:sync-from-starter (excluded paths + which .mcp.json / settings.json entries to skip). Copy to project-profile.json only via /setup:start — never by hand.",

  "schema": 1,

  "_mode_doc": "greenfield | brownfield. Detected from the project file count (>= 50 files => brownfield), confirmed in the interview.",
  "mode": "greenfield",

  "_git_host_doc": "github | bitbucket | gitlab | none. Detected from `origin`, confirmed. `none` = no remote yet; PR credentials are deferred until one exists.",
  "git_host": "github",

  "_workflow_doc": "Asked: preset + pr_required (Screen 1, Q3). Everything else is DERIVED once from the preset table in create-CLAUDE_MD → Identify Git Workflow and never asked. preset is one of trunk | feature-branch | gitflow — `custom` is not a profile value; a custom workflow goes through /setup:create-CLAUDE_MD instead. pr_required=false (\"I push straight to main\") overrides pr_dest / protected / merge / orchestrate_publish as shown here.",
  "workflow": {
    "_preset_doc": "trunk | feature-branch | gitflow",
    "preset": "trunk",
    "pr_required": false,
    "trunk": "main",
    "integration": "main",
    "branch_types": ["feat", "fix", "chore", "refactor"],
    "_branch_pattern_doc": "Derived from the tracker answer: jira => <type>/<KEY>-<slug>, none => <type>/<slug>.",
    "branch_pattern": "<type>/<slug>",
    "pr_dest": "commit on main or short-lived branches merged locally — no PR",
    "protected": [],
    "_merge_doc": "squash | merge-commit | ff. `ff` only for the direct-push override; otherwise the preset's implied value.",
    "merge": "ff",
    "_orchestrate_publish_doc": "push | branch-local. gitflow and any PR-gated flow => branch-local; direct push and feature-branch => push.",
    "orchestrate_publish": "push"
  },

  "_tracker_doc": "jira | none. Asked (Screen 2, Q4). none => the backlog is .agents/backlog.md.",
  "tracker": "none",

  "_confluence_doc": "Asked (Screen 2, Q5). Shares the Atlassian MCP server and token with Jira.",
  "confluence": false,

  "_codex_doc": "Asked (Screen 2, Q6) as a TEAM question. `command -v codex` on the bootstrap machine is informational only and never sets this field — the file is shared.",
  "codex": false,

  "_app_surface_doc": "unknown | none | web | mobile | desktop | tui. NOT asked by /setup:start — always written as `unknown`, which keeps all QA tooling. /setup:create-CLAUDE_MD detects it from the stack once code exists.",
  "app_surface": "unknown",

  "_language_doc": "pl | en. Asked first (Screen 0). Governs Claude <-> developer communication only; code, comments and commits stay English.",
  "language": "pl",

  "_teams_doc": "Values the team harness (/start-team, /monitor, .claude/lib/team-*.sh) reads instead of hardcoding them. Written by /setup:teams; a project without this block refuses /start-team before any side effect. Read with `jq` only — never eval'd or sourced. tracker: jira | github | none (sets the ticket-key regex; none = local `L<n>` keys allocated by team-tracker.sh, zero tracker calls). github: REQUIRED when tracker=github or pr_provider=github, ignored otherwise — repo (`owner/repo`), project_owner, project_number plus the Project v2 IDs project_id, status_field_id and status_options.started/.delivered (read the IDs once with `gh project field-list <number> --owner <owner> --format json`). pr_provider: azure-devops | github (none is reserved and refused); github.repo is required for pr_provider=github too. trunk: the line team branches are cut from (base-ref = origin/<trunk>). branch_types: allowed <type>/<key>-<slug> prefixes. required_tools: must be on PATH before a team starts. clone_parent: OPTIONAL — where team clones live; omit it for the default (siblings of this repo). A leading ~ is expanded and spaces are allowed. clone_name: OPTIONAL — the clone directory template; omit it for the default `<repo dir>-{team}`. `{team}` is the team name, `{Team}` its capitalized form, and the placeholder must END the template (exactly one, no `/`) because the clone glob is a prefix. seed_files: copied into every clone (.env is chmod 600 when listed). env_file_required: refuse to start without a mode-600 .env. build_check: the build command, run with `bash -c` in the clone root. test_gate: a script path, or `none` to skip the gate. gates: auto | manual-mql5 (manual-mql5 = the gates are run by hand and the QA report says so). Values below are neutral examples — not any project's real ones.",
  "teams": {
    "tracker": "github",
    "github": {
      "repo": "owner/repo",
      "project_owner": "owner",
      "project_number": 1,
      "project_id": "PVT_example",
      "status_field_id": "PVTSSF_example",
      "status_options": {"started": "opt-started", "delivered": "opt-delivered"}
    },
    "pr_provider": "github",
    "trunk": "main",
    "branch_types": ["feature", "bugfix", "chore"],
    "clone_name": "<repo>-{team}",
    "required_tools": ["git", "jq", "tmux", "claude", "codex", "gh"],
    "seed_files": [".claude/settings.local.json", ".agents/memory/user-profile.md"],
    "env_file_required": false,
    "build_check": "echo 'no build check configured'",
    "test_gate": "none",
    "gates": "auto",
    "_channel_doc": "OPTIONAL — names and policy of the agent-mail channel between the supervision roles (Supervisor, TeamLead, Advisor, Reviewer), shared by the whole team; machine paths never go here (they live in the gitignored .agents/team/channel.local.json written by /setup:teams → channel). project_code: the registry key and message label for this project. mail_suffix: appended to every role name to form the recipient name (Advisor + XY = AdvisorXY), so two projects on one machine never share a recipient; may be empty. tmux_prefix: prefix of the role sessions' tmux names (default: the repo dir slug). advisor: pair (a Reviewer on a second-vendor model co-signs tier-2 decisions) | solo (the Advisor decides alone, every note says reviewer: none). notifier: osascript | notify-send | none. Defaults when a key is absent: mail_suffix empty, tmux_prefix the repo dir slug, advisor pair when codex is true else solo, notifier none. Read by .claude/lib/team-channel.sh (team_channel_load), never parsed elsewhere. Schema and protocol: .agents/reference/agent-mail.md.",
    "_policy_doc": "OPTIONAL — project policy of the supervision model; every key optional, an absent key = the conservative behaviour named here, never another project's values. The values below are one project's choices, shown as examples to adopt consciously. sensitive_paths: globs whose changes make a team question tier 2 (Advisor pair) and a QA ready-with-warnings the Advisor's disposition; absent = the list in CLAUDE.md → Validation → Test policy. A judgement input for the TeamLead and the Advisor (attested, not proven) — no script enforces it yet. classes: the deterministic tier-1 waivers of an ask-tier prompt (merge_line, allow_offline, add_ask, prod_diagnose — prod_diagnose also needs dir, a relative directory of read-only diagnose scripts, and privileged, a regex of the subcommands that are not); deny, egress, the SQL guard and unreadable prompts are never waived. Each class is OFF until its enabled is exactly true here; the Operator's runtime switch (team-watch.sh mode class <name> off) can then narrow it, never widen it. prod_diagnose also needs dir and privileged. tickets: labels and lines on tickets the Supervisor/Advisor create from recommendations; absent = no labels, the recommendation line is still written. closure: automatic ticket-closure rules the Supervisor applies; absent = no automatic closure. Human overview: docs/teams/06-permissions.md (starter repo).",
    "policy": {
      "sensitive_paths": ["src/payments/**", "src/auth/**", "src/webhooks/**", "src/licensing/**"],
      "classes": {
        "merge_line": {"enabled": false},
        "allow_offline": {"enabled": false},
        "add_ask": {"enabled": false}
      },
      "tickets": {
        "auto_label": "auto-created",
        "path_labels": {"brainstorm": "brainstorm", "quick": "quick-change", "team": "team", "analysis": "analysis"},
        "recommendation_line": "Created from a recommendation — the Operator verifies it when the work starts",
        "new_epic_when_none_fits": true
      },
      "closure": {
        "done_after_release_minutes_without_5xx": 40,
        "dry_run_max_days": 7,
        "on_hold_after_days": 7
      }
    },
    "channel": {
      "project_code": "XY",
      "mail_suffix": "XY",
      "tmux_prefix": "xy",
      "advisor": "pair",
      "notifier": "none"
    }
  },

  "_jira_doc": "Jira sync settings. estimates: none | timetracking | <custom field id> — none = no time estimate is sent (sizes stay in the description); absent = the field remembered in .agents/memory/domain/jira.md, else $JIRA_ESTIMATE_FIELD, else timetracking. commit_drafts: reserved — committing .agents/jira/ is unsupported in v1.",
  "jira": { "estimates": "timetracking", "commit_drafts": false },

  "_ba_doc": "BA profile. enabled: a Business Analyst runs discovery and the backlog in this repo (written by /setup:start later; nothing reads it yet). meetings_dir: where raw transcripts are dropped for /meeting-notes. vendor / client: participant-group labels in meeting notes (defaults Vendor / Client). Absent block = BA profile off.",
  "ba": { "enabled": false, "meetings_dir": ".agents/sources/meetings/", "vendor": "", "client": "" },

  "_commands_doc": "The command-group manifest, DERIVED from the answers above and shown for confirmation. false => /setup:start offers to prune the group (files + coupled edits) and records the deleted paths in .claude/.starter-sync.json → excluded. qa_runtime_ui is true whenever app_surface is unknown or web. ba = the BA command group (meeting-notes, update-backlog, check-backlog, resync) — pruning arrives with the /setup:start interview.",
  "commands": {
    "pr": true,
    "jira": false,
    "confluence": false,
    "codex": false,
    "qa_runtime_ui": true,
    "ba": false
  }
}
