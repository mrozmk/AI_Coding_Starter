// Regression runner config — copied by /setup:regression to `runner.config` (never over an existing file).
// Placeholders:
//   <spec-dir-relative>  runner.spec_dir relative to THIS file's directory (Playwright resolves testDir
//                        and outputFile against the config's directory, not the repo root):
//                        config e2e/playwright.config.ts + spec_dir e2e/regression → './regression'
//   <report-relative>    runner.report relative to this file's directory (e2e/.results/report.json → './.results/report.json')
//   <desktop-project>, <mobile-project>  the names in runner.devices
//   <guard-module-relative>  the path from this file's directory to .claude/lib/regression/guard.mjs
//                        (config e2e/playwright.config.ts → '../.claude/lib/regression/guard.mjs')
// No `webServer` on purpose: a regression run targets a deployed environment only (REGRESSION_BASE_URL,
// resolved from .claude/regression.json `environments`), never an app this run starts itself.
// Workers, the per-project selection grep, slowMo and blocked service workers come from the run
// manifest; without REGRESSION_RUN this config refuses to load — run specs through /regression-tests.
// Never add `extraHTTPHeaders` or `httpCredentials` here: a production run refuses such a config.
import { defineConfig, devices } from '@playwright/test';
import { loadRunManifest, runnerOptions } from '<guard-module-relative>';

const opts = runnerOptions(loadRunManifest());

export default defineConfig({
  testDir: '<spec-dir-relative>',
  retries: 0,
  workers: opts.workers,
  // Under the run directory: Playwright cleans its outputDir at start, so it never sits near committed files.
  outputDir: opts.outputDir,
  reporter: [['json', { outputFile: '<report-relative>' }]],
  use: {
    baseURL: process.env.REGRESSION_BASE_URL,
    ...opts.use,
  },
  projects: [
    { name: '<desktop-project>', grep: opts.grepFor('<desktop-project>'), use: { ...devices['Desktop Chrome'] } },
    { name: '<mobile-project>', grep: opts.grepFor('<mobile-project>'), use: { ...devices['iPhone 13'] } },
  ],
});
