tools: Read, mcp__{device_mcp_server}__browser_navigate, mcp__{device_mcp_server}__browser_resize, mcp__{device_mcp_server}__browser_snapshot, mcp__{device_mcp_server}__browser_take_screenshot, mcp__{device_mcp_server}__browser_click, mcp__{device_mcp_server}__browser_type, mcp__{device_mcp_server}__browser_press_key, mcp__{device_mcp_server}__browser_wait_for, mcp__{device_mcp_server}__browser_evaluate, mcp__{device_mcp_server}__browser_console_messages, mcp__{device_mcp_server}__browser_close
