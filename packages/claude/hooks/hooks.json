{
  "description": "AI Coding Starter harness \u2014 synchronous commit/push/memory guards, advisory comment/file-class/memory-scope nudges, local read telemetry and audit, session preflight.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT}\" ] || { echo \"BLOCKED: CLAUDE_PLUGIN_ROOT is not set \u2014 the guard-commit guard cannot run and blocks instead of vanishing\" >&2; exit 2; }; node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook guard-commit",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT}\" ] || { echo \"BLOCKED: CLAUDE_PLUGIN_ROOT is not set \u2014 the guard-push guard cannot run and blocks instead of vanishing\" >&2; exit 2; }; node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook guard-push",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook audit-append",
            "async": true
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook audit-append",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT}\" ] || { echo \"BLOCKED: CLAUDE_PLUGIN_ROOT is not set \u2014 the guard-memory guard cannot run and blocks instead of vanishing\" >&2; exit 2; }; node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook guard-memory",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook audit-append",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook guard-comments"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook nudge-files"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook guard-memory-scope"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook audit-append",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook audit-append",
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook track-memory-read",
            "async": true
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook track-memory-read",
            "async": true
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook nudge-lsp"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runner.mjs\" --host claude --hook check-deps"
          }
        ]
      }
    ]
  }
}
