{
  "_doc": "PERMISSIVE NEGATIVE CONTROL for tests: Claude Code host adapter. `skill_frontmatter` is merged into every packaged SKILL.md; the planning entrypoints stay user-invocable only (contract 5). `reviewer` describes the Claude reviewer child spawned by review.mjs when the author host is Codex (contract 8).",
  "schema_version": 1,
  "host": "claude",
  "cli": "claude",
  "skill_frontmatter": {
    "disable-model-invocation": true
  },
  "skill_frontmatter_passthrough": [
    "argument-hint"
  ],
  "manifest_keywords": [
    "planning",
    "review",
    "harness",
    "ai-coding-starter"
  ],
  "plugin_root_env": "CLAUDE_PLUGIN_ROOT",
  "project_root_env": "CLAUDE_PROJECT_DIR",
  "registry": {
    "installed_plugins": "~/.claude/plugins/installed_plugins.json",
    "plugin_key": "harness@ai-coding-starter"
  },
  "reviewer": {
    "model": "fable",
    "effort": "high",
    "output_format": "json",
    "isolation": [
      "--restricted",
      "--safe-mode",
      "--tools",
      "",
      "--strict-mcp-config",
      "--setting-sources",
      "",
      "--no-session-persistence",
      "--permission-mode",
      "dontAsk"
    ],
    "stdin": "context-pack",
    "timeout_minutes": 50
  }
}