#!/usr/bin/env node
// Mock `codex exec` for offline adapter tests. Behaviour selected by MOCK_MODE.
const fs = require('node:fs');
const mode = process.env.MOCK_MODE || 'ok';
const args = process.argv.slice(2);
if (args[0] === 'login') { process.stdout.write(mode === 'auth-preflight' ? 'Not logged in\n' : 'Logged in using ChatGPT\n'); process.exit(0); }
if (args[0] === '--version') { process.stdout.write('codex-cli 9.9.9\n'); process.exit(0); }
const outIdx = args.indexOf('--output-last-message');
const outFile = outIdx !== -1 ? args[outIdx + 1] : null;
let stdin = '';
process.stdin.on('data', (d) => { stdin += d; });
process.stdin.on('end', () => {
  if (process.env.MOCK_RECORD) fs.writeFileSync(process.env.MOCK_RECORD, JSON.stringify({ args, stdinBytes: Buffer.byteLength(stdin), stdinHead: stdin.slice(0, 200), cwd: process.cwd(), depth: process.env.HARNESS_REVIEW_DEPTH || null }));
  if (mode.startsWith('exec-')) return executor();
  if (mode === 'auth') { process.stderr.write('Error: not logged in\n'); process.exit(1); }
  if (mode === 'hang') { setTimeout(() => process.exit(0), 60000); return; }
  if (mode === 'empty' || mode === 'stale') process.exit(0);
  const model = mode === 'wrong-model' ? 'gpt-4.1' : 'gpt-6-astra';
  process.stderr.write(`OpenAI Codex v0.0.0-mock\n--------\nworkdir: ${process.cwd()}\nmodel: ${model}\nprovider: openai\napproval: never\nsandbox: read-only\nreasoning effort: ${process.env.MOCK_EFFORT || 'high'}\nsession id: mock\n--------\nuser\n(prompt)\n`);
  if (mode === 'tool') process.stderr.write('exec\nbash -lc ls\n');
  const output = mode === 'malformed' ? 'Sure! Here is my review: verdict ship'
    : mode === 'gap-typed' ? JSON.stringify({ verdict: 'revise', findings: [], evidence_read: ['plugin:skills/prime/SKILL.md'], missing_context: [{ kind: 'missing-file', detail: 'src/export/job.ts' }] })
    : mode === 'contradictory' ? JSON.stringify({ verdict: 'ship', findings: [{ severity: 'major', kind: 'patchable', where: 'Files', problem: 'p', consequence: 'c', fix: 'f', evidence: 'CLAUDE.md' }], evidence_read: ['CLAUDE.md'], missing_context: [] })
    : mode === 'ship' ? JSON.stringify({ verdict: 'ship', findings: [{ severity: 'minor', kind: 'patchable', where: 'Files', problem: 'p', consequence: 'c', fix: 'f', evidence: 'CLAUDE.md' }], evidence_read: ['CLAUDE.md', 'plugin:skills/prime/SKILL.md'], missing_context: [] })
    : JSON.stringify({ verdict: 'revise', findings: [{ severity: 'major', kind: 'patchable', where: 'Files', problem: 'missing test file', consequence: 'untested path', fix: 'add test', evidence: '.agents/specs/2026-01-01-fixture.md' }], evidence_read: ['plugin:skills/prime/SKILL.md'], missing_context: [] });
  if (outFile) fs.writeFileSync(outFile, output);
  process.stderr.write('codex\n(final)\ntokens used\n1\n');
  process.exit(0);
});

// Executor modes (MOCK_MODE starting with `exec-`): a worker child that reads its sandbox and repo
// from argv and, unlike the reviewer modes, may write into the repo before it exits.
function executor() {
  const path = require('node:path');
  const sandbox = args[args.indexOf('--sandbox') + 1];
  const repo = args[args.indexOf('-C') + 1];
  const write = (rel, text) => {
    const abs = path.join(repo, rel);
    fs.mkdirSync(path.dirname(abs), { recursive: true });
    fs.writeFileSync(abs, text);
  };
  const touch = process.env.MOCK_TOUCH || 'src/app.js';
  if (mode === 'exec-auth-mid-run') { process.stderr.write('OpenAI Codex v0.0.0-mock\n'); process.exit(1); }
  const model = mode === 'exec-wrong-model' ? 'gpt-4.1' : 'gpt-6-astra';
  process.stderr.write(`OpenAI Codex v0.0.0-mock\n--------\nworkdir: ${repo}\nmodel: ${model}\nprovider: openai\napproval: never\nsandbox: ${sandbox}\nreasoning effort: ${process.env.MOCK_EFFORT || 'high'}\nsession id: mock\n--------\nuser\n(prompt)\n`);
  if (mode === 'exec-nonzero') process.exit(7);
  if (mode === 'exec-hang') { setTimeout(() => process.exit(0), 60000); return; }
  let final = '## Output Report\nok\n';
  if (mode === 'exec-write-ok' || mode === 'exec-wrong-model') write(touch, `changed by the mock ${Date.now()}\n`);
  if (mode === 'exec-write-tamper') { write(touch, 'changed\n'); write('.agents/plans/x.md', 'tampered\n'); }
  if (mode === 'exec-write-outside-scope') { write(touch, 'changed\n'); write('other.js', 'outside\n'); }
  if (mode === 'exec-write-empty-with-delta') { write(touch, 'changed\n'); final = ''; }
  if (mode === 'exec-write-empty') final = '';
  // A write-mode run that reports and changes nothing — the shape a corrective run on an already
  // dirty tree takes when the fix turns out to be unnecessary.
  if (mode === 'exec-write-noop') final = '## Output Report\nnothing to change\n';
  if (mode === 'exec-read-ok') final = 'opinion\n';
  if (mode === 'exec-read-wrote') { write(touch, 'read-only child wrote this\n'); final = 'opinion\n'; }
  if (mode === 'exec-read-schema-ok') final = JSON.stringify({ verdict: 'ship', findings: [] });
  if (mode === 'exec-read-schema-bad') final = 'not json';
  if (mode === 'exec-write-leaves-descendant') {
    write(touch, 'leader wrote this\n');
    // Same process group as the leader on purpose: the orchestrator must notice a descendant that
    // outlives its parent, which a detached grandchild would hide.
    require('node:child_process').spawn(process.execPath, ['-e', `setTimeout(()=>require('node:fs').writeFileSync(${JSON.stringify(path.join(repo, 'late.js'))}, 'late\\n'), 2000)`], { stdio: 'ignore' }).unref();
  }
  if (outFile) fs.writeFileSync(outFile, final);
  process.stderr.write('codex\n(final)\ntokens used\n1\n');
  process.exit(0);
}
