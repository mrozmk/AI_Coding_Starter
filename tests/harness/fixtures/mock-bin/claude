#!/usr/bin/env node
// Mock `claude -p` for offline adapter tests. Behaviour selected by MOCK_MODE.
const fs = require('node:fs');
const mode = process.env.MOCK_MODE || 'ok';
const args = process.argv.slice(2);
if (args[0] === 'auth') { process.stdout.write(mode === 'auth-preflight' ? '{"loggedIn":false}' : '{"loggedIn":true}'); process.exit(0); }
if (args[0] === '--version') { process.stdout.write('9.9.9 (Claude Code)\n'); process.exit(0); }
let stdin = '';
process.stdin.on('data', (d) => { stdin += d; });
process.stdin.on('end', () => {
  if (process.env.MOCK_RECORD) fs.writeFileSync(process.env.MOCK_RECORD, JSON.stringify({ args, stdinBytes: Buffer.byteLength(stdin), stdinHead: stdin.slice(0, 200), cwd: process.cwd(), depth: process.env.HARNESS_REVIEW_DEPTH || null }));
  if (process.env.MOCK_TOUCH) fs.appendFileSync(process.env.MOCK_TOUCH, '\nmutated during review\n');
  if (mode === 'auth') { process.stderr.write('Not logged in. Run `claude` to authenticate.\n'); process.exit(1); }
  if (mode === 'empty') process.exit(0);
  if (mode === 'malformed') { process.stdout.write('{"type":"result","result":"{\\"verdict\\": \\"ship\\", \\"findings\\": [", "modelUsage":{"claude-fable-5-1":{}}}'); process.exit(0); }
  if (mode === 'hang') { setTimeout(() => process.exit(0), 60000); return; }
  if (mode === 'nonzero') { process.stdout.write('{"type":"result","is_error":true,"result":"API error"}'); process.exit(2); }
  if (mode === 'error-envelope') { process.stdout.write('{"type":"result","is_error":true,"result":"rate limited","modelUsage":{"claude-fable-5-1":{"outputTokens":5}}}'); process.exit(0); }
  const output = mode === 'gap'
    ? { verdict: 'ship', findings: [], evidence_read: ['CLAUDE.md'], missing_context: ['.agents/memory/architecture.md'] }
    : mode === 'gap-typed'
      ? { verdict: 'revise', findings: [], evidence_read: ['CLAUDE.md'], missing_context: [{ kind: 'required-decision', detail: 'refund window 14 or 30 days' }, { kind: 'external-fact', detail: 'Stripe webhook retry cadence' }] }
    : mode === 'contradictory'
      ? { verdict: 'ship', findings: [{ severity: 'critical', kind: 'fundamental', where: 'Solution', problem: 'p', consequence: 'c', fix: 'f', evidence: 'CLAUDE.md' }], evidence_read: ['CLAUDE.md'], missing_context: [] }
    : mode === 'bad-evidence'
      ? { verdict: 'ship', findings: [], evidence_read: ['/etc/passwd', 'CLAUDE.md'], missing_context: [] }
    : mode === 'subagent'
      ? { verdict: 'ship', findings: [], evidence_read: ['CLAUDE.md'], missing_context: [] }
    : mode === 'unanchored'
      ? { verdict: 'revise', findings: [{ severity: 'major', kind: 'patchable', where: 'Files', problem: 'p', consequence: 'c', fix: 'f', evidence: ' ' }], evidence_read: [], missing_context: [] }
      : { verdict: 'ship', findings: [], evidence_read: ['plugin:skills/prime/SKILL.md', '.agents/specs/2026-01-01-fixture.md'], missing_context: [] };
  const model = mode === 'wrong-model' ? 'claude-sonnet-5' : 'claude-fable-5-1';
  process.stdout.write(JSON.stringify({ type: 'result', subtype: 'success', is_error: false, num_turns: 1, result: JSON.stringify(output), structured_output: output, modelUsage: { 'claude-haiku-4-5-20251001': { inputTokens: 900, outputTokens: 9 }, [model]: { inputTokens: 10, outputTokens: 80 } }, subagent_stats: { spawned: mode === 'subagent' ? 1 : 0 }, permission_denials: mode === 'denied' ? [{ tool_name: 'Bash' }] : [] }));
  process.exit(0);
});
